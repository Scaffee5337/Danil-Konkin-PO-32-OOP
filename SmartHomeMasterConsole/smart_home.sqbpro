n index="2" value="60"/><column index="3" value="54"/><column index="4" value="72"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">PRAGMA foreign_keys = ON;
CREATE TABLE Rooms (
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    Title TEXT NOT NULL UNIQUE,
    Floor INTEGER NOT NULL
);
CREATE TABLE Devices (
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    RoomId INTEGER NOT NULL,
    Model TEXT NOT NULL,
    Power REAL NOT NULL,
    Type TEXT NOT NULL,
    FOREIGN KEY (RoomId)
        REFERENCES Rooms(Id)
);
CREATE TABLE TelemetryLogs (
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    DeviceId INTEGER NOT NULL,
    Reading REAL NOT NULL,
    Timestamp TEXT NOT NULL,
    FOREIGN KEY (DeviceId)
        REFERENCES Devices(Id)
);</sql><sql name="SQL 2*">PRAGMA foreign_key_list(Devices);</sql><current_tab id="1"/></tab_sql></sqlb_project>
